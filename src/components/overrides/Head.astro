---
import Default from '@astrojs/starlight/components/Head.astro';

const { entry } = Astro.locals.starlightRoute;
const slug = entry.id || 'index';
const ogUrl = new URL(`/open-graph/${slug}.png`, Astro.site);
---

<Default><slot /></Default>
<meta property="og:image" content={ogUrl.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogUrl.href} />
<script
  defer
  src="https://stats.alexislours.com/script.js"
  data-performance="true"
  data-website-id="e759bdaf-b7af-4744-b737-26379b873eda"
  data-domains="docs.ltdsave.app"></script>
