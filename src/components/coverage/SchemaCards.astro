---
import Bar from './Bar.astro';
import {
  pct,
  SCHEMA_KEYS,
  SCHEMA_ACCENTS,
  SCHEMA_LABELS,
  type SchemaKey,
  type Totals,
} from '../../lib/coverage';

interface Props {
  schemaTotals: Record<SchemaKey, Totals>;
}

const { schemaTotals } = Astro.props;

function buildViews(t: Totals) {
  return [
    {
      label: 'Unique leaves',
      leafCount: t.uniqueLeafCount,
      documented: t.uniqueDocumented,
      partial: t.uniquePartial,
      undocumented: t.uniqueUndocumented,
    },
    {
      label: 'Per instance',
      leafCount: t.leafCount,
      documented: t.documented,
      partial: t.partial,
      undocumented: t.undocumented,
    },
  ];
}
---

<div class="cov-cards">
  {
    SCHEMA_KEYS.map((key) => {
      const t = schemaTotals[key];
      const views = buildViews(t);
      return (
        <a class="cov-card" href={`#per-page-${key}`} style={`--accent:${SCHEMA_ACCENTS[key]}`}>
          <div class="cov-card-head">
            <span class="cov-card-name">{SCHEMA_LABELS[key]}</span>
          </div>

          {views.map((v) => (
            <div class="cov-card-view">
              <div class="cov-card-view-label">{v.label}</div>

              <div class="cov-card-splits">
                <div class="mini mini-doc">
                  <div class="mini-label">Done</div>
                  <div class="mini-pct">{pct(v.documented, v.leafCount).toFixed(1)}%</div>
                </div>
                <div class="mini mini-part">
                  <div class="mini-label">Part.</div>
                  <div class="mini-pct">{pct(v.partial, v.leafCount).toFixed(1)}%</div>
                </div>
                <div class="mini mini-undoc">
                  <div class="mini-label">To do</div>
                  <div class="mini-pct">{pct(v.undocumented, v.leafCount).toFixed(1)}%</div>
                </div>
              </div>

              <Bar documented={v.documented} partial={v.partial} total={v.leafCount} />

              <div class="cov-card-foot">
                <span>
                  {v.documented.toLocaleString()} / {v.leafCount.toLocaleString()} leaves
                </span>
              </div>
            </div>
          ))}
        </a>
      );
    })
  }
</div>

<style>
  .cov-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    margin: 0 0 2.5rem;
  }

  .cov-card {
    display: block;
    padding: 0.95rem 1.1rem;
    border-radius: 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s,
      transform 0.15s;
    position: relative;
    border-left: 3px solid var(--accent);
  }

  .cov-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .cov-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.7rem;
    gap: 0.5rem;
  }

  .cov-card-name {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .cov-card-view + .cov-card-view {
    margin-top: 0.9rem;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--sl-color-gray-5);
  }

  .cov-card-view-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.45rem;
  }

  .cov-card-splits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
    margin-bottom: 0.55rem;
  }

  .mini {
    background: var(--sl-color-gray-6);
    border-radius: 0.35rem;
    padding: 0.35rem 0.25rem;
    text-align: center;
    margin-top: 0;
  }

  .mini-label {
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3);
    line-height: 1;
    margin-bottom: 0.3rem;
    white-space: nowrap;
  }

  .mini-pct {
    font-size: 0.95rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .mini-doc .mini-pct {
    color: #16a34a;
  }
  .mini-part .mini-pct {
    color: #eab308;
  }
  .mini-undoc .mini-pct {
    color: var(--sl-color-text);
  }

  .cov-card-foot {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--sl-color-gray-2);
  }
</style>
